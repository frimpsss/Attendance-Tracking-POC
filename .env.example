# ==============================================================================
# STUDENT ATTENDANCE MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` in the repository root (or inside each app directory).
# Frontends ONLY read VITE_* variables. Never place service_role keys in VITE_*.

# 1. Shared Supabase Project Configuration (Required for all 3 apps)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Alias supported if you prefer standard Supabase naming:
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cross-App URLs (Used for role-mismatch redirect links & QR deep links)
VITE_ADMIN_APP_URL=http://localhost:5173
VITE_LECTURER_APP_URL=http://localhost:5174
VITE_STUDENT_APP_URL=http://localhost:5175

# 3. Default Institution Timezone
VITE_DEFAULT_TIMEZONE=Africa/Accra

# 4. Admin / Seed Tooling Only (NEVER expose in VITE_* or frontend code)
# Used ONLY by `pnpm seed:users` (scripts/seed-demo-users.mjs) and Edge Functions
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-for-cli-seeding-only
DEMO_DEFAULT_PASSWORD=ChangeMe123!
